# ── База данных ────────────────────────────────────────────────────────────
# SQLite (по умолчанию, для старта):
DATABASE_URL=sqlite+aiosqlite:///./data/nvrmon.db
# PostgreSQL (прод):
# DATABASE_URL=postgresql+psycopg://nvrmon:nvrmon@db:5432/nvrmon

# ── Шифрование паролей устройств ─────────────────────────────────────────────
# Ключ Fernet. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ОБЯЗАТЕЛЬНО заменить в проде. Если не задан — генерируется временный (данные не расшифруются после перезапуска!).
SECRET_KEY=

# ── Планировщик опроса ───────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5
# Время суточной проверки архива (час и минута, локальное время сервера)
ARCHIVE_CHECK_HOUR=9
ARCHIVE_CHECK_MINUTE=0
# Макс. одновременных подключений к NVR (semaphore) — щадим VPN-каналы
MAX_CONCURRENT_POLLS=10
# Сколько неудачных циклов подряд до алерта "NVR недоступен"
NVR_UNREACHABLE_THRESHOLD=3
# Сколько минут камера должна быть offline до алерта
CAMERA_OFFLINE_ALERT_MINUTES=10
# Допустимое расхождение часов NVR с сервером (минуты) до алерта
TIME_DRIFT_ALERT_MINUTES=5
# Порог "дыры" в архиве (минуты) для алерта
ARCHIVE_GAP_ALERT_MINUTES=60
# Порог заполнения HDD для алерта (%), 0 = выключено
HDD_USAGE_ALERT_PERCENT=0

# ── Сетевые таймауты по умолчанию (переопределяются на устройстве) ──────────
DEFAULT_HTTP_TIMEOUT=15
DEFAULT_HTTP_RETRIES=2

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Глобальный выключатель уведомлений
TELEGRAM_ENABLED=true

# ── Вход в панель ────────────────────────────────────────────────────────────
# Логин/пароль для доступа к веб-панели. Если ADMIN_PASSWORD пуст —
# вход ОТКЛЮЧЁН и панель открыта всем в сети (удобно для теста, опасно в проде).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Прочее ───────────────────────────────────────────────────────────────────
# Часовой пояс сервера = часовой пояс ваших регистраторов (важно для проверки
# времени и архива, если NVR отдаёт «наивное» локальное время). Примеры:
# Europe/Moscow, Asia/Yekaterinburg, Asia/Novosibirsk, UTC.
TZ=UTC
LOG_LEVEL=INFO
# Режим разработки: автозапуск встроенного mock-сервера NVR на /mock/*
MOCK_MODE=false
