# ── База данных ────────────────────────────────────────────────────────────
# SQLite (по умолчанию, для старта):
DATABASE_URL=sqlite+aiosqlite:///./data/nvrmon.db
# PostgreSQL (прод):
# DATABASE_URL=postgresql+psycopg://nvrmon:nvrmon@db:5432/nvrmon

# ── Часовой пояс для показа времени в панели ─────────────────────────────────
# IANA-имя зоны. По умолчанию UTC. Примеры: Asia/Vladivostok, Europe/Moscow.
TIMEZONE=UTC

# ── Шифрование паролей устройств ─────────────────────────────────────────────
# Ключ Fernet. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ОБЯЗАТЕЛЬНО заменить в проде. Если не задан — генерируется временный (данные не расшифруются после перезапуска!).
SECRET_KEY=

# ── Планировщик опроса ───────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=5
# Время суточной проверки архива (час и минута, локальное время сервера)
ARCHIVE_CHECK_HOUR=9
ARCHIVE_CHECK_MINUTE=0
# Макс. одновременных подключений к NVR (semaphore) — щадим VPN-каналы
MAX_CONCURRENT_POLLS=10
# Сколько неудачных циклов подряд до алерта "NVR недоступен"
NVR_UNREACHABLE_THRESHOLD=3
# Сколько минут камера должна быть offline до алерта
CAMERA_OFFLINE_ALERT_MINUTES=10
# Допустимое расхождение часов NVR с сервером (минуты) до алерта
TIME_DRIFT_ALERT_MINUTES=5
# Порог "дыры" в архиве (минуты) для алерта
ARCHIVE_GAP_ALERT_MINUTES=60
# Порог заполнения HDD для алерта (%), 0 = выключено
HDD_USAGE_ALERT_PERCENT=0

# ── Контроль качества картинки (компьютерное зрение) ─────────────────────────
# Период проверки кадров, мин. 0 = выключено. Рекомендуется 15–30.
QUALITY_CHECK_MINUTES=0
QUALITY_DARK_THRESHOLD=30      # яркость ниже → тёмный/чёрный кадр
QUALITY_UNIFORM_THRESHOLD=8    # контраст ниже → однотонный (залеплен объектив)
QUALITY_BLUR_THRESHOLD=15      # резкость ниже → расфокус
QUALITY_FROZEN_DIFF=1.0        # среднее отличие кадров меньше → кадр идентичен
QUALITY_FROZEN_CHANGED_FRAC=0.01  # доля изменившихся пикселей меньше → кадр идентичен (защита от ложного «завис» на статичных сценах)
QUALITY_FROZEN_CHECKS=3        # столько идентичных проверок ПОДРЯД = «завис»

# ── Сетевые таймауты по умолчанию (переопределяются на устройстве) ──────────
DEFAULT_HTTP_TIMEOUT=15
DEFAULT_HTTP_RETRIES=2

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Глобальный выключатель уведомлений
TELEGRAM_ENABLED=true
# Двусторонний бот-пульт (команды /status /round /cam, кнопки под алертами)
TELEGRAM_BOT_ENABLED=true
# Прокси к Telegram, если сервер не пускают напрямую (DPI/блокировка, как в РФ).
# http://user:pass@host:3128  или  socks5://host:1080  (пусто = без прокси)
TELEGRAM_PROXY=

# ── Watchdog: внешний «пульс» (сторож для самого монитора) ───────────────────
# URL пинга healthchecks.io (или совместимого). Пусто = выключено.
# Создайте Check на healthchecks.io, период = WATCHDOG_INTERVAL_MINUTES, и вставьте Ping URL:
WATCHDOG_URL=
WATCHDOG_INTERVAL_MINUTES=1

# ── Вход в панель ────────────────────────────────────────────────────────────
# Логин/пароль для доступа к веб-панели. Если ADMIN_PASSWORD пуст —
# вход ОТКЛЮЧЁН и панель открыта всем в сети (удобно для теста, опасно в проде).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Прочее ───────────────────────────────────────────────────────────────────
# Часовой пояс сервера = часовой пояс ваших регистраторов (важно для проверки
# времени и архива, если NVR отдаёт «наивное» локальное время). Примеры:
# Europe/Moscow, Asia/Yekaterinburg, Asia/Novosibirsk, UTC.
TZ=UTC
LOG_LEVEL=INFO
# Режим разработки: автозапуск встроенного mock-сервера NVR на /mock/*
MOCK_MODE=false

# ── Доступ извне / HTTPS (профиль https с Caddy) ─────────────────────────────
# Домен для авто-HTTPS. Удобно взять бесплатный у MikroTik: IP → Cloud → DDNS,
# даст имя вида xxxxxxxx.sn.mynetname.net. Нужны проброшенные порты 80 и 443.
DOMAIN=
