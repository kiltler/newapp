{
  "uid": "nvrmon-main",
  "title": "NVR Monitor",
  "tags": [
    "nvr",
    "cctv"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Аварии (алерты)",
        "datasource": {
          "type": "prometheus",
          "uid": "nvrmon-prom"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "nvrmon_active_alerts > 0",
        "titleFormat": "Есть активные алерты",
        "step": "60s"
      },
      {
        "name": "NVR недоступен",
        "datasource": {
          "type": "prometheus",
          "uid": "nvrmon-prom"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "nvrmon_device_reachable == 0",
        "titleFormat": "NVR недоступен",
        "textFormat": "{{device}}",
        "tagKeys": "device",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "🛰  Обзор",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Монитор",
      "datasource": {
        "type": "prometheus",
        "uid": "nvrmon-prom"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "nvrmon_up",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nvrmon-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ОНЛАЙН"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Свежесть опроса",
